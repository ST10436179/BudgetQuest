<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bq_bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <TextView android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/levelBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="8dp" android:textColor="@color/bq_accent" />
        <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/bq_text_secondary" />
        <ProgressBar android:id="@+id/gauge" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:max="100" android:progress="46" />
        <TextView android:id="@+id/gaugeText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="R 2,340 of R 5,000" android:textColor="@color/white" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="+"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/bq_accent" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
