<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bq_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reset Password" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold" />
    <EditText android:id="@+id/username" style="@style/Widget.BudgetQuest.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Username" />
    <EditText android:id="@+id/answer" style="@style/Widget.BudgetQuest.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="Security Answer" />
    <EditText android:id="@+id/newPassword" style="@style/Widget.BudgetQuest.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:hint="New Password" android:inputType="textPassword" />
    <TextView android:id="@+id/errorText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/bq_warning" />
    <Button android:id="@+id/resetBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Reset" />
</LinearLayout>
