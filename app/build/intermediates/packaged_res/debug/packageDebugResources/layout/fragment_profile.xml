<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bq_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/avatar" android:layout_width="56dp" android:layout_height="56dp" android:background="@drawable/bg_card" android:gravity="center" android:textColor="@color/white" android:textStyle="bold" />
        <TextView android:id="@+id/username" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/white" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/memberSince" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/bq_text_secondary" />
        <TextView android:id="@+id/rank" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/bq_accent" />
        <TextView android:id="@+id/xpProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/white" />
        <ProgressBar android:id="@+id/levelProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="500" />

        <TextView android:id="@+id/badgeFirst" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="🥇 First Entry — log your first expense" android:textColor="@color/white" />
        <TextView android:id="@+id/badgeWeek" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚔️ Week Warrior — 7 day streak" android:textColor="@color/white" />
        <TextView android:id="@+id/badgeHero" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🏆 Budget Hero — no overspend month" android:textColor="@color/white" />
        <Button android:id="@+id/manageCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="⚙️ Manage Categories" />
        <Button android:id="@+id/setGoals" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="🎯 Set Budget Goals" />
        <Button android:id="@+id/logoutBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:backgroundTint="@color/bq_warning" android:text="Log Out" />
    </LinearLayout>
</ScrollView>
